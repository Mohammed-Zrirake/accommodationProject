# ============================================
# 🗄️ Root .gitignore
# ============================================

# Build and output folders
bin/
obj/

# Frontend dependencies and build
node_modules/
dist/
build/

# Environment files
.env
.env.local
.env.*.local

# Debug/Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# macOS system files
.DS_Store

# IDE and editor files (user-specific)
*.user
*.suo
.vscode/
.idea/
*.code-workspace

# User secrets
secrets.json

# Backups
api/backups/

# ============================================
# ✅ Keep These Files (DO NOT ignore!)
# ============================================
!package.json
!package-lock.json
!yarn.lock
!*.csproj
!*.sln
!appsettings.json
!.env.example
